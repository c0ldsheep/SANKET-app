<?xml version="1.0" encoding="utf-8"?>
<!-- Type scale (sp): 13 caption, 15 body, 17 title, 22 app title, 26 status. One family, two weights. -->
<resources>
    <style name="Text">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">15sp</item>
        <item name="android:lineSpacingExtra">3sp</item>
    </style>

    <style name="Text.AppTitle">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">22sp</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="Text.Status">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">26sp</item>
        <item name="android:lineSpacingExtra">2sp</item>
    </style>

    <style name="Text.Section">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">17sp</item>
    </style>

    <style name="Text.Title">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Text.Secondary">
        <item name="android:textColor">@color/text_2</item>
    </style>

    <style name="Text.Caption">
        <item name="android:textColor">@color/text_3</item>
        <item name="android:textSize">13sp</item>
        <item name="android:lineSpacingExtra">2sp</item>
    </style>

    <style name="Text.Value">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>

    <!-- Inherits the platform button for focus, centring and accessibility; looks are ours. -->
    <style name="Button" parent="android:Widget.Material.Button">
        <item name="android:minWidth">64dp</item>
        <item name="android:layout_height">@dimen/button_height</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:stateListAnimator">@animator/press</item>
        <item name="android:elevation">0dp</item>
    </style>

    <style name="Button.Primary">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/on_accent</item>
    </style>

    <style name="Button.Tonal">
        <item name="android:background">@drawable/bg_button_tonal</item>
        <item name="android:textColor">@color/accent</item>
    </style>

    <style name="Button.Text">
        <item name="android:layout_height">44dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:background">@drawable/bg_button_text</item>
        <item name="android:textColor">@color/accent</item>
    </style>
</resources>
