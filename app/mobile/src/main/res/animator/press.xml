<?xml version="1.0" encoding="utf-8"?>
<!-- Buttons dip slightly while pressed and spring back a little slower: feedback within 100 ms. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="true" android:state_pressed="true">
        <set>
            <objectAnimator android:duration="100" android:interpolator="@android:interpolator/decelerate_quad"
                android:propertyName="scaleX" android:valueTo="0.97" android:valueType="floatType" />
            <objectAnimator android:duration="100" android:interpolator="@android:interpolator/decelerate_quad"
                android:propertyName="scaleY" android:valueTo="0.97" android:valueType="floatType" />
        </set>
    </item>
    <item>
        <set>
            <objectAnimator android:duration="140" android:interpolator="@android:interpolator/decelerate_quad"
                android:propertyName="scaleX" android:valueTo="1.0" android:valueType="floatType" />
            <objectAnimator android:duration="140" android:interpolator="@android:interpolator/decelerate_quad"
                android:propertyName="scaleY" android:valueTo="1.0" android:valueType="floatType" />
        </set>
    </item>
</selector>
